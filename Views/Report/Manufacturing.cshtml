@* Views/Report/Manufacturing.cshtml *@

@model WebServiceCosmetics.ViewModel.ManufacturingReportVM

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Manufacturing Report
        </h1>

        <a asp-action="Index"
           class="btn btn-outline-dark">

            Back to Dashboard

        </a>

    </div>

    <!-- FILTER -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-3">

                        <label>Date From</label>

                        <input type="date"
                               name="DateFrom"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label>Date To</label>

                        <input type="date"
                               name="DateTo"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label>Employee</label>

                        <select name="Employees_id"
                                class="form-control"
                                asp-items="Model.Employees">

                            <option value="">
                                All Employees
                            </option>

                        </select>

                    </div>
                    <div class="mb-4">

                        <a asp-action="ManufacturingExcel"
                           class="btn btn-success">

                            Excel

                        </a>

                        <a asp-action="ManufacturingPdf"
                           class="btn btn-danger">

                            PDF

                        </a>

                        <a asp-action="ManufacturingWord"
                           class="btn btn-dark">

                            Word

                        </a>

                    </div>
                    <div class="col-md-3 d-flex align-items-end">

                        <button class="btn btn-primary w-100">

                            Filter

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TOTAL -->

    <div class="card shadow-sm mb-4">

        <div class="card-body text-center">

            <h5>
                Total Production Quantity
            </h5>

            <h2>
                @Model.TotalQuantity
            </h2>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered">

                <thead class="table-light">

                    <tr>

                        <th>Product</th>
                        <th>Employee</th>
                        <th>Quantity</th>
                        <th>Date</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Manufacturing)
                    {
                        <tr>

                            <td>
                                @(item.ProductModel?.Name ?? "No product")
                            </td>

                            <td>
                                @(item.Employees?.Full_Name ?? "No employee")
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                @item.Date.ToString("dd.MM.yyyy")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>