@model WebServiceCosmetics.ViewModel.ReportDashboardVM

<div class="container mt-5">

    <h1 class="mb-5">
        Enterprise Reports Center
    </h1>

    <!-- KPI -->

    <div class="row mb-5">

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Revenue</h6>
                <h3>@Model.TotalRevenue</h3>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Sales</h6>
                <h3>@Model.TotalSales</h3>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Production</h6>
                <h3>@Model.TotalManufacturing</h3>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Purchases</h6>
                <h3>@Model.TotalPurchases</h3>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Salary</h6>
                <h3>@Model.TotalSalary</h3>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm p-4 text-center">
                <h6>Credits</h6>
                <h3>@Model.TotalCredits</h3>
            </div>
        </div>

    </div>

    <!-- MODULES -->

    <div class="row">

        <div class="col-md-4 mb-4">

            <a asp-action="Sales"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 p-5 text-center">

                    <h1>💰</h1>

                    <h4 class="mt-3">
                        Sales Reports
                    </h4>

                    <p class="text-muted">
                        Product sales analytics
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a asp-action="Manufacturing"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 p-5 text-center">

                    <h1>🏭</h1>

                    <h4 class="mt-3">
                        Manufacturing Reports
                    </h4>

                    <p class="text-muted">
                        Manufacturing analytics
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a asp-action="Purchases"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 p-5 text-center">

                    <h1>📦</h1>

                    <h4 class="mt-3">
                        Purchases Reports
                    </h4>

                    <p class="text-muted">
                        Raw material purchases
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a asp-action="Salary"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 p-5 text-center">

                    <h1>👨‍💼</h1>

                    <h4 class="mt-3">
                        Salary Reports
                    </h4>

                    <p class="text-muted">
                        Payroll analytics
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-4">

            <a asp-action="Credit"
               class="text-decoration-none">

                <div class="card shadow-lg border-0 p-5 text-center">

                    <h1>💳</h1>

                    <h4 class="mt-3">
                        Credit Reports
                    </h4>

                    <p class="text-muted">
                        Credit analytics
                    </p>

                </div>

            </a>

        </div>

    </div>

</div>